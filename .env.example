# ==============================================================================
# INDRA Sovereign AI Workstation — Client Configuration Template
# ==============================================================================
# Automatically updated by running:
#   indra set-server --url http://<GPU_HOST>:8000 --key wb_live_...
# ==============================================================================

# Remote or Local GPU Backend Server Base URL
WORKBENCH_API_BASE=http://127.0.0.1:8000
OPENAI_BASE_URL=http://127.0.0.1:8000/v1

# Client Bearer Authentication Key (Generated on GPU server via `workbench admin export-client`)
WORKBENCH_API_KEY='wb_live_replace_with_your_dynamic_client_key'
OPENAI_API_KEY='wb_live_replace_with_your_dynamic_client_key'

# Execution Sandbox Mode: 'local' for native host execution, 'docker' for isolated container
TERMINAL_ENV=local

# Local Obsidian Knowledge Vault Root Directory
OBSIDIAN_VAULT_PATH=./MyVault

# Optional: Poppler PDF rendering library (Windows)
# POPPLER_PATH='C:\Program Files (x86)\poppler-25.12.0\Library\bin'
